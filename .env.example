# =========================================================================
# Arquivo de configuração de ambiente (EXEMPLO)
# Copie para .env e preencha com os valores reais do seu ambiente.
# IMPORTANTE: NUNCA versione o arquivo .env (com credenciais reais) no Git.
# =========================================================================

# === Configuração da Aplicação ===
FLASK_ENV=development
FLASK_DEBUG=1

# === Segurança ===
# Necessária para proteger sessões e assinaturas.
# Gere uma nova usando: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret

# === Banco de Dados ===
# SQLite (desenvolvimento padrão): deixar vazio para usar instance/sge_dev.db
# Para Produção com MySQL:
# DATABASE_URL=mysql+pymysql://root:minhasenha@127.0.0.1:3306/escola_db
DATABASE_URL=sqlite:///instance/school.db

# === Configurações da Escola ===
SCHOOL_NAME=Sistema Completo de Gestão Escolar
SCHOOL_ABBREVIATION=SGE

# === E-mail (Serviço SMTP) ===
# Usado para recuperação de senhas, informes, etc.
# Em modo FLASK_DEBUG=1 e MAIL_SERVER=localhost, os links serão exibidos no console
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@escola.com

# === Segurança Adicional (Login Limit e Sessão) ===
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
# Descomente em produção ao rodar com certificado SSL/HTTPS configurado:
# SESSION_COOKIE_SECURE=true
